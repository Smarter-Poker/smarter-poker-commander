.env
.env.local
.env.production.local
# Generated/pulled env files must never be committed. .env.commander.prod and
# .env.vercel.local slipped past the rules above and are already tracked; their
# values happen to be blank today, but the next `vercel env pull` would write
# real secrets straight into a tracked file. These patterns cover every such
# variant (.env.example stays tracked — it matches neither).
.env*.local
.env.commander.*
*.log
.DS_Store
test-results/
playwright-report/
.vercel
_to_delete/

# Build artefacts and editor leftovers (2026-09-03 cleanup)
tsconfig.tsbuildinfo
*.bak
test_output.png

# Copied out of node_modules by the copy scripts, in prebuild AND in the
# vercel.json buildCommand, because only one of those is the build that
# deploys. Build output, so never committed.
public/zxing/
public/tesseract/
