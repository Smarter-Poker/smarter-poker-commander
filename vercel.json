{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "ci-marker/**": false,
      "backup/**": false,
      "build/**": false
    }
  },
  "ignoreCommand": "git diff HEAD~1 HEAD --name-only | grep -qE '\\.(ts|tsx|js|jsx|json|css|scss)$|^(src|pages|public)/' && exit 1 || exit 0",
  "buildCommand": "node scripts/copy-zxing-wasm.mjs && NODE_OPTIONS='--max-old-space-size=7168' next build",
  "installCommand": "npm install --legacy-peer-deps",
  "headers": [
    {
      "source": "/zxing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
