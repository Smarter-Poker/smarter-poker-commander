{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "buildCommand": "node scripts/copy-zxing-wasm.mjs && node scripts/copy-tesseract-assets.mjs && NODE_OPTIONS='--max-old-space-size=7168' next build",
  "installCommand": "npm install --legacy-peer-deps",
  "headers": [
    {
      "source": "/zxing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tesseract/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
