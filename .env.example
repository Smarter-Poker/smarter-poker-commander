# smarter-poker-commander — env template
# Copy to .env.local for development; populate via Vercel dashboard for prod.

NEXT_PUBLIC_SUPABASE_URL=https://kuklfnapbkmacvwxktbh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_JWT_SECRET is DEAD CONFIG for JWT verification as of 2026-09-01.
# The project moved to asymmetric (ES256) signing keys; tokens are verified
# against the project JWKS and there is no symmetric secret to configure.
#
# It is still read as a FALLBACK signing secret by TWO independent session
# systems. DO NOT DELETE IT until BOTH dedicated secrets below are set:
#   1. src/lib/auth/pinSession.*    → COMMANDER_PIN_SESSION_SECRET
#      (the commander_admin_session admin cookie)
#   2. src/lib/commander/auth.js    → COMMANDER_STAFF_SESSION_SECRET
#      (the x-staff-session token: venue PIN terminals and owner logins)
#
# Deleting it first silently invalidates every live session in both systems,
# with no error explaining why. For (2) the fallthrough is especially quiet:
# the chain advances to SUPABASE_SERVICE_ROLE_KEY, which is always set, so
# nothing fails — every staff member is simply signed out at once.
SUPABASE_JWT_SECRET=

# HMAC signing secret for the commander_admin_session cookie.
#
# MUST be set before SUPABASE_JWT_SECRET is removed. To migrate without
# invalidating live sessions, set this to the SAME value SUPABASE_JWT_SECRET
# currently holds, deploy, confirm admin login still works, and only then
# delete SUPABASE_JWT_SECRET.
#
# CHANGING THIS VALUE INVALIDATES ALL ADMIN PIN SESSIONS. Every admin has to
# re-enter their PIN. That is recoverable, but do it deliberately, not as a
# side effect of a rotation script.
#
# Any high-entropy random string (e.g. `openssl rand -base64 48`).
COMMANDER_PIN_SESSION_SECRET=

# HMAC signing secret for the `x-staff-session` token issued by
# /api/staff/verify-pin and /api/check-subscription, stored client-side as
# `commander_staff`. Signed and verified in src/lib/commander/auth.js.
# Session TTLs: 12h for venue PIN terminals, 7 days for owner logins.
#
# CHANGING THIS VALUE LOGS OUT EVERY STAFF MEMBER AT ONCE — including
# unattended PIN terminals on venue floors, which need a PIN re-entry by
# someone physically present. Treat a rotation as a floor-operations event.
#
# MIGRATION ORDER — do not skip a step:
#   1. Set this to the CURRENT value of SUPABASE_JWT_SECRET, everywhere.
#      Same value ⇒ same signatures ⇒ ZERO invalidation.
#   2. Deploy. Confirm staff/owner login works and that no
#      `[commander-auth] falling back to SUPABASE_SERVICE_ROLE_KEY` line
#      appears in the logs.
#   3. Soak past the longest TTL — 7 days (owner sessions).
#   4. ONLY THEN drop the SUPABASE_JWT_SECRET / SUPABASE_SERVICE_ROLE_KEY
#      fallbacks in src/lib/commander/auth.js and delete SUPABASE_JWT_SECRET.
#
# Until this is set, staff sessions are signed with SUPABASE_JWT_SECRET, and
# if that is missing, with SUPABASE_SERVICE_ROLE_KEY — a full-database-bypass
# credential that should not be HMAC key material, and whose rotation would
# otherwise silently log out every staff member.
#
# Any high-entropy random string (e.g. `openssl rand -base64 48`).
COMMANDER_STAFF_SESSION_SECRET=
# ─────────────────────────────────────────────────────────────────────────────

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
