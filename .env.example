# smarter-poker-commander — env template
# Copy to .env.local for development; populate via Vercel dashboard for prod.

NEXT_PUBLIC_SUPABASE_URL=https://kuklfnapbkmacvwxktbh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_JWT_SECRET is DEAD CONFIG for JWT verification as of 2026-09-01.
# The project moved to asymmetric (ES256) signing keys; tokens are verified
# against the project JWKS and there is no symmetric secret to configure.
#
# It is still read as a FALLBACK signing secret for the admin PIN session
# cookie (src/lib/auth/pinSession.*). DO NOT DELETE IT until
# COMMANDER_PIN_SESSION_SECRET below is set — deleting it first silently
# invalidates every live admin PIN session and locks admins out of the
# dashboard, with no error explaining why.
SUPABASE_JWT_SECRET=

# HMAC signing secret for the commander_admin_session cookie.
#
# MUST be set before SUPABASE_JWT_SECRET is removed. To migrate without
# invalidating live sessions, set this to the SAME value SUPABASE_JWT_SECRET
# currently holds, deploy, confirm admin login still works, and only then
# delete SUPABASE_JWT_SECRET.
#
# CHANGING THIS VALUE INVALIDATES ALL ADMIN PIN SESSIONS. Every admin has to
# re-enter their PIN. That is recoverable, but do it deliberately, not as a
# side effect of a rotation script.
#
# Any high-entropy random string (e.g. `openssl rand -base64 48`).
COMMANDER_PIN_SESSION_SECRET=
# ─────────────────────────────────────────────────────────────────────────────

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
